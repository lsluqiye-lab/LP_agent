# LongPort OpenAPI Credentials
LONGPORT_APP_KEY=your_app_key_here
LONGPORT_APP_SECRET=your_app_secret_here
LONGPORT_ACCESS_TOKEN=your_access_token_here

# LLM API Keys (Depending on which provider you use)
DEEPSEEK_API_KEY=sk-xxxx
GEMINI_API_KEY=AIxxxx
# ANALYST_DEEPSEEK_API_KEY= (Optional: separate key for analysts)

# Tavily Search API (用于DeepSeek的实时网络搜索)
TAVILY_API_KEY=tvly-xxxx

# LLM Providers & Models
LLM_PROVIDER=deepseek
DEEPSEEK_MODEL=deepseek-chat
# ANALYST_LLM_PROVIDER=deepseek

# Feishu Notification (Optional)
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxx

# DingTalk Notification (Optional)
# 基础模式：仅 Webhook URL（适用于 IP 白名单方式）
DINGTALK_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=xxxx
# 加签模式：如果钉钉机器人设置了加签验证，需要填写 Sign Secret
DINGTALK_SIGN_SECRET=SECxxxxxx

# Notification Channel: "feishu" or "dingtalk"
NOTIFICATION_CHANNEL=feishu

# Risk Settings (Optional Overrides)
RISK_SCORE_LOCKDOWN=30
RISK_SCORE_CAUTIOUS=50
MAX_DAILY_DRAWDOWN_PCT=0.02

# Log Level
LOG_LEVEL=INFO
